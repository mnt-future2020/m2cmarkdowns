// ============================================
// SEO SETTINGS
// ============================================

model SEOSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Page-specific SEO settings
  page            String  @unique // e.g., "home", "about", "products", etc.
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?

  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_settings")
}

// ============================================
// BANNER CAROUSEL
// ============================================

model BannerImage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  // Optional click-through target. When set, clicking the banner on the storefront
  // navigates the shopper to the linked product/category page.
  //   linkType  = 'product' | 'category' (null = not clickable)
  //   linkValue = the target's slug (resolved to a URL on the storefront)
  //   linkLabel = the target's display name, cached for the admin list/edit view
  linkType     String?
  linkValue    String?
  linkLabel    String?
  updatedBy    String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("banner_images")
}

// ============================================
// HUB MANAGEMENT
// ============================================

model Hub {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  city      String
  state     String
  zipCode   String?
  phone     String?
  email     String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  orders    Order[]
  shipments VendorShipment[]

  @@map("hubs")
}

// ============================================
// VENDOR ENQUIRY
// ============================================

model VendorEnquiry {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  companyName String
  // "REGISTERED" (has GST) | "UNREGISTERED" (no GST). GST is optional for the latter.
  vendorType  String    @default("REGISTERED")
  gstNumber   String?
  email       String
  phone       String
  website     String?
  status      String    @default("pending") // pending | approved | rejected
  approvedAt  DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("vendor_enquiries")
}

// One-time email verification codes. Used to prove an applicant owns the email
// address on the public vendor-enquiry form before their enquiry is accepted.
// The code itself is never stored in the clear — only its SHA-256 hash.
model EmailOtp {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  purpose    String    @default("vendor_enquiry") // namespaces codes by flow
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)   // wrong-code guesses, capped to stop brute force
  verified   Boolean   @default(false)
  consumedAt DateTime?               // set the moment a verified code is spent on a submit
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, purpose])
  @@map("email_otps")
}

// Customer return / refund / replacement request. One record per returned
// order item, kept as a dedicated collection (not JSON on Order) so a customer
// can accumulate a full return history and admins can manage them as their own
// queue with evidence, a status timeline, and an audit trail.
model ReturnRequest {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  returnId String @unique // human id, e.g. RET-2026-000123

  // Links
  orderId       String  @db.ObjectId // Order.id
  orderCode     String // Order.orderId (ORD-YYYY-...)
  orderItemId   String? @db.ObjectId
  customerId    String  @db.ObjectId
  customerName  String?
  customerEmail String?
  customerPhone String?

  // Product snapshot (frozen at request time)
  productId    String? @db.ObjectId
  productName  String
  productImage String?
  variantId    String? @db.ObjectId
  size         String?
  color        String?
  quantity     Int     @default(1)

  // Money — itemAmount is in the order currency; itemAmountINR is the frozen
  // INR twin used for the actual gateway refund (Razorpay settles in INR).
  currency      String @default("INR")
  itemAmount    Float
  itemAmountINR Float?

  // The request
  reason         String // reason code (see returnController REASONS)
  reasonNote     String?
  evidenceImages String[] @default([])
  resolution     String // 'REFUND' | 'REPLACEMENT'

  // Refund preference / gateway tracking
  refundMethod       String? // 'ORIGINAL' (bank) | 'WALLET'
  upiId              String?
  // Replacement preference: 'CREDIT' (wallet store-credit) | 'ITEM' (ship with next order)
  replacementMethod  String?
  refundAmount       Float?
  refundId           String?
  refundStatus       String? // gateway: INITIATED | PROCESSED | FAILED | MANUAL | NONE
  paymentReference   String?
  // Human label of the ORIGINAL instrument the customer paid with, fetched from
  // the gateway at refund time (e.g. "UPI · name@bank", "Card •••• 1234").
  paymentMethodLabel String?

  // Replacement tracking
  replacementValue         Float?
  replacementEntitlementId String? @db.ObjectId

  // Lifecycle status + timeline
  status            String  @default("Pending Review")
  statusHistory     Json? // [{ status, note, at, by }]
  customerConfirmed Boolean @default(false)

  // Admin decision / audit
  adminNote       String?
  rejectionReason String?
  decidedById     String?   @db.ObjectId
  decidedByName   String?
  decidedAt       DateTime?

  // Disposition of the physical item on approval: restocked to sellable inventory,
  // or set aside as damaged. null until the return is approved.
  restocked       Boolean?
  dispositionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

// Customer store-credit wallet. Balance is always held in INR (the base currency);
// USD orders/refunds convert at the rate in effect. One row per customer; the
// balance is the running total of the WalletTransaction ledger below.
model Wallet {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @unique @db.ObjectId
  balance    Float    @default(0) // INR
  currency   String   @default("INR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("wallets")
}

// Immutable ledger of every wallet movement — the source of truth + full audit.
model WalletTransaction {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  walletId     String  @db.ObjectId
  customerId   String  @db.ObjectId
  type         String // CREDIT | DEBIT
  amount       Float // INR, always positive
  balanceAfter Float // INR balance immediately after this entry
  source       String // REFUND | REPLACEMENT | ORDER_REDEMPTION | ORDER_REVERSAL | ADMIN_ADJUSTMENT
  description  String?

  // References (whichever apply)
  orderId         String? @db.ObjectId
  orderCode       String?
  returnRequestId String? @db.ObjectId
  returnCode      String?

  // Audit — who caused it
  createdById   String? @db.ObjectId
  createdByName String?
  createdByType String? // customer | admin | system

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ── Credit Points (loyalty rewards) ─────────────────────────────────────────
// Mirrors the Wallet: a per-customer running points balance backed by an immutable
// ledger. Points are earned per purchase (admin-configurable rate, credited on
// DELIVERED by default) and redeemed at checkout as a money tender (redeemValue
// per point, in INR). One row per customer.
model CreditPointsAccount {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @unique @db.ObjectId
  balance    Int      @default(0) // running points balance
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("credit_points_accounts")
}

// Immutable ledger of every points movement — source of truth + audit.
// EARN rows double as FIFO "lots": `remaining` tracks how many of that lot's points
// are still unspent/unexpired, so redemption and expiry consume oldest-first.
model CreditPointsTransaction {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  accountId    String @db.ObjectId
  customerId   String @db.ObjectId
  type         String // EARN | REDEEM | EXPIRE | REVERSE | ADJUST
  points       Int // always positive; `type` gives the direction
  balanceAfter Int // points balance immediately after this entry
  source       String // ORDER_EARN | ORDER_REDEMPTION | ORDER_REVERSAL | EXPIRY | ADMIN_ADJUSTMENT
  description  String?

  // Money context (INR): redeemValue × points at the time, for display/reconciliation.
  valueInr Float?

  // FIFO lot accounting — EARN rows only. `remaining` starts == points and is drawn
  // down by REDEEM/EXPIRE/REVERSE; `expiresAt` is set when expiry is enabled.
  remaining Int?
  expiresAt DateTime?

  // References (whichever apply)
  orderId   String? @db.ObjectId
  orderCode String?

  // Audit — who caused it
  createdById   String? @db.ObjectId
  createdByName String?
  createdByType String? // customer | admin | system

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([accountId])
  @@index([createdAt])
  @@index([type, expiresAt])
  @@map("credit_points_transactions")
}

// Singleton settings row controlling the Credit Points program (admin-editable).
model CreditPointsSettings {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  enabled Boolean @default(false)

  // Earning: award `earnPointsPerUnit` points for every `earnUnitInr` of eligible
  // order value (in INR). e.g. 1 point per ₹100 → earnPointsPerUnit=1, earnUnitInr=100.
  earnPointsPerUnit Float @default(1)
  earnUnitInr       Float @default(100)
  // Only orders at/above this INR value earn points (0 = no minimum).
  minOrderAmountToEarnInr Float @default(0)
  // When points are credited: 'DELIVERED' (refund-safe, default) or 'PLACED'.
  earnOn String @default("DELIVERED")

  // Redemption: each point is worth this many INR when redeemed.
  redeemValuePerPointInr Float @default(1)
  // Customer must hold at least this many points to redeem (0 = none).
  minPointsToRedeem Int @default(0)
  // Points may cover at most this percent of an order's total (0-100).
  maxRedeemPercent Float @default(20)

  // Points expire this many days after being earned (0 = never).
  expiryDays Int @default(0)

  // Which storefront(s) the program applies to: BOTH | IN_ONLY | COM_ONLY.
  region String @default("BOTH")

  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Maker-checker approval — settings changes are held (program not live) until approved.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById   String?   @db.ObjectId
  submittedByName String?
  approvedById    String?   @db.ObjectId
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  @@map("credit_points_settings")
}

// A customer-initiated payout of wallet store-credit to their bank/UPI. Self-service
// (no admin approval): the wallet is debited the moment the request is made, and the
// linked WalletTransaction (source WITHDRAWAL) records that debit. Admin/finance then
// fulfils the payout and marks it Completed (or Failed → the amount is credited back).
model WalletWithdrawal {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  withdrawalId String  @unique // WD-YYYY-NNNNNN
  customerId   String  @db.ObjectId
  amount       Float // INR, debited from the wallet
  currency     String  @default("INR")

  method        String // 'UPI' | 'BANK'
  upiId         String?
  accountName   String?
  accountNumber String? // beneficiary account (payout destination)
  ifsc          String?
  bankName      String?

  status       String  @default("Processing") // Processing | Completed | Failed
  walletTxnId  String? @db.ObjectId // the debit ledger entry
  reversalTxnId String? @db.ObjectId // credit-back ledger entry if Failed
  note         String? // customer note / admin payout reference
  failureReason String?

  // RazorpayX automated payout tracking (null when paid out manually).
  payoutId     String? // pout_… id from RazorpayX
  payoutMode   String? // UPI | IMPS | NEFT
  payoutStatus String? // raw gateway status: queued|pending|processing|processed|reversed|failed
  autoPayout   Boolean @default(false)

  // Payout fulfilment audit
  processedById   String?   @db.ObjectId
  processedByName String?
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("wallet_withdrawals")
}

// Items pulled out of sellable stock because they came back damaged/defective on
// a return (admin chose NOT to restock). This is the "Damaged Items" ledger — a
// permanent, fully-attributed record: what, how many, why, when, and by whom.
model DamagedStock {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productId       String?  @db.ObjectId
  productName     String
  productImage    String?
  variantId       String?  @db.ObjectId
  size            String?
  color           String?
  sku             String?
  quantity        Int
  reason          String   // return reason label, e.g. "Damaged or defective"
  note            String?  // admin's disposition note
  sourceType      String   @default("return") // return | manual
  returnRequestId String?  @db.ObjectId
  returnCode      String?  // RET-…
  orderId         String?  @db.ObjectId
  orderCode       String?  // ORD-…
  customerName    String?
  recordedById    String?  @db.ObjectId
  recordedByName  String?
  createdAt       DateTime @default(now())

  // ── Return-to-vendor (RTV) lifecycle ──
  // A defective item received at the admin hub is sent back to the vendor who
  // supplied it. The item is attributed to that vendor at write time, then moves
  // AT_HUB → SENT_TO_VENDOR → RECEIVED_BY_VENDOR, with a full dispatch audit.
  vendorId           String?   @db.ObjectId
  vendorName         String?
  vendorCode         String?
  vendorReturnStatus String    @default("AT_HUB") // AT_HUB | SENT_TO_VENDOR | RECEIVED_BY_VENDOR | CLOSED
  courier            String?   // carrier used to ship back to the vendor
  trackingNumber     String?
  sentToVendorAt     DateTime?
  sentById           String?   @db.ObjectId
  sentByName         String?
  vendorReceivedAt   DateTime?
  vendorReturnNote   String?   // dispatch / disposition note for the RTV

  @@index([productId])
  @@index([createdAt])
  @@index([vendorId])
  @@index([vendorReturnStatus])
  @@map("damaged_stock")
}

// A replacement credit recorded in the customer's account once a REPLACEMENT
// return is approved. It is redeemed against a future eligible order per M2C
// replacement rules — never auto-added to an unrelated order.
model ReplacementEntitlement {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String  @db.ObjectId
  returnRequestId String  @db.ObjectId
  returnCode      String
  productName     String
  productImage    String?
  value           Float
  currency        String  @default("INR")
  status          String  @default("Pending") // Pending | Available | Redeemed | Cancelled
  redeemedOrderId String? @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@map("replacement_entitlements")
}

// ============================================
// CONTACT/WEBSITE ENQUIRIES
// ============================================

model ContactEnquiry {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  /// Marketing attribution — "How did you hear about us?". Stores a stable slug
  /// (search_engine | social_media | referral | existing_customer |
  /// advertisement | trade_show | email_newsletter | other) so enquiries can be
  /// grouped in reports. Null on enquiries submitted before this field existed.
  hearAboutUs String?
  /// Free text captured when hearAboutUs is "other". Kept separate so the source
  /// report still groups these under a single "Other" bucket instead of
  /// fragmenting into one-off values.
  hearAboutUsOther String?
  status    String    @default("new") // new | read | replied | closed
  repliedAt DateTime?
  closedAt  DateTime?
  notes     String? // Admin notes
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("contact_enquiries")
}

// ============================================
// SUPPORT SYSTEM
// ============================================

model SupportTicket {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  ticketId    String @unique
  subject     String
  category    String
  priority    String @default("medium") // low, medium, high, urgent
  description String
  status      String @default("open") // open, in_progress, resolved, closed

  attachments String[] @default([])

  creatorId    String  @db.ObjectId
  creatorType  String // "admin", "vendor", "user"
  creatorName  String?
  creatorEmail String?

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model TicketMessage {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId String        @db.ObjectId
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message     String
  attachments String[] @default([])

  senderId   String @db.ObjectId
  senderType String // "admin", "vendor", "user"
  senderName String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("ticket_messages")
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  userId     String       @db.ObjectId
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String       @db.ObjectId
  product    Product      @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
  orderId    String       @db.ObjectId
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating     Int          @default(5)
  comment    String?
  images     String[]     @default([])
  isApproved Boolean      @default(false)
  status     ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A customer may review a given product only once in their lifetime. The
  // orderId still records which purchase the review came from, but a repeat
  // purchase of the same product does not unlock a second product review.
  @@unique([userId, productId])
  @@map("reviews")
}

// Purchase-experience feedback — asked on every order (delivery, packaging,
// overall M2C shopping experience), independent of the per-product review.
// One per customer per order.
model ExperienceReview {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  userId     String       @db.ObjectId
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String       @db.ObjectId
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating     Int          @default(5)
  comment    String?
  images     String[]     @default([])
  isApproved Boolean      @default(false)
  status     ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orderId])
  @@map("experience_reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// QC CHECKER MANAGEMENT
// ============================================

model QCChecker {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  checkerId String @unique // Human readable checker ID (e.g., QC-001)
  email     String @unique
  password  String // Hashed password
  name      String
  title     String?
  phone     String

  // Address
  address      String?
  addressLine2 String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("India")

  // Personal
  dateOfBirth DateTime?

  // Alternate contact
  alternatePhone String?
  alternateEmail String?

  // Media / documents (stored as URL or base64 data URL)
  profilePhoto String?
  idProof      String?

  // Professional
  joiningDate    DateTime @default(now())
  specialization String?
  experience     Int?     @default(0) // Years of experience
  // Structured certifications: array of { name, documentUrl }. Legacy rows may
  // still hold a plain string (kept readable since this is a flexible Json field).
  certifications Json?

  // Assigned Hub
  assignedHubId String? @db.ObjectId

  // Status & Activity
  status      QCCheckerStatus @default(ACTIVE)
  isActive    Boolean         @default(true)
  lastLoginAt DateTime?

  // Password reset (forgot-password flow), mirrors User/Admin/Vendor.
  resetToken       String?
  resetTokenExpiry DateTime?

  // Stats
  assignedVendors      Int @default(0)
  completedInspections Int @default(0)

  // Relations
  vendorsList  Vendor[]     @relation("VendorQCChecker")
  productsList Product[]    @relation("ProductQCChecker")
  inspections  Inspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qc_checkers")
}

enum QCCheckerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================
// BILLING & INVOICE SETTINGS
// ============================================

model InvoiceSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  invoicePrefix           String   @default("INV")
  sequenceLength          Int      @default(4)
  currentSequence         Int      @default(1)
  financialYearStart      DateTime
  financialYearEnd        DateTime
  autoFinancialYear       Boolean  @default(true)
  // Month (1-12) and day of month when FY starts — used for auto rollover
  financialYearStartMonth Int      @default(4) // 4 = April (Indian FY)
  financialYearStartDay   Int      @default(1) // 1st of the month
  formatTemplate          String   @default("{PREFIX}-{FY}-{SEQ}")
  // Cloudinary URL of the logo printed on every invoice. Falls back to the company
  // logo when unset.
  invoiceLogo             String?
  // Cloudinary URL of the authorised digital signature printed in the invoice's
  // "Authorised Signature" block. Optional.
  signature               String?
  // GST % charged on the SHIPPING amount (weight rate + delivery-zone fee).
  // Dynamic — null/0 means no tax on shipping.
  shippingGstPercentage   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_settings")
}

// ============================================
// DELIVERY ZONES (destination-based availability + flat delivery fee)
// ============================================
// A zone decides whether M2C delivers to a destination and the FLAT fee added on
// top of the weight-based shipping rate. Hierarchy: Country → (all or specific)
// States → (all or specific) Cities. More specific matches win. Both ISO and name
// are stored for each selected state so backend matching needs no dataset.
model DeliveryZone {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  countryIso  String   // "IN"
  countryName String   // "India"
  allStates   Boolean  @default(false) // true = every state in the country
  states      Json     @default("[]")  // [{ iso, name }] when allStates = false
  allCities   Boolean  @default(false) // true = every city in the selected states
  cities      String[] @default([])    // city names when allCities = false
  flatFee     Float    @default(0)     // INR, added per order to the weight rate
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countryIso])
  @@map("delivery_zones")
}

// ============================================
// SETTLEMENTS
// ============================================

model Settlement {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  settlementNumber String // e.g. SET-2024-0001
  vendorId         String    @db.ObjectId
  vendorName       String
  orderId          String    @db.ObjectId
  billingNumber    String // e.g. same as order invoice number
  period           String // e.g. "February 2024"

  // ── Vendor payout breakdown ────────────────────────────────────────────────
  // M2C BUYS from the vendor and resells to the customer, so the vendor makes a
  // taxable supply to M2C and must be paid their GST on top of their goods value.
  // This is a DIFFERENT tax from Order.tax (which is charged to the customer on
  // M2C's higher selling price). Same HSN rate, different base.
  //
  // Nullable because settlements created before this breakdown existed stored a
  // base-only figure in `amount`; readers fall back to `baseAmount ?? amount`
  // and `taxAmount ?? 0` rather than requiring a data migration.
  /// Vendor's goods value = basePrice x qty, before their GST.
  baseAmount       Float?
  /// Vendor's GST on baseAmount. 0 for vendors with no GSTIN (unregistered).
  taxAmount        Float?
  /// Rate applied — set only when every line shares one rate; null when mixed.
  gstPercentage    Float?

  /// GROSS payable to the vendor = baseAmount + taxAmount.
  amount           Float
  dueDate          DateTime?
  status           String    @default("Pending") // Pending, Processing, Paid, Failed
  paymentDate      DateTime?
  transactionId    String?

  vendor Vendor @relation(fields: [vendorId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Maker-checker approval — a settlement cannot be paid out until approved.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById   String?   @db.ObjectId
  submittedByName String?
  approvedById    String?   @db.ObjectId
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  @@map("settlements")
}

// ============================================
// INSPECTION MANAGEMENT
// ============================================

model Inspection {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relations
  vendorId  String    @db.ObjectId
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  checkerId String    @db.ObjectId
  checker   QCChecker @relation(fields: [checkerId], references: [id], onDelete: Cascade)

  // Assignment Details
  poNumber          String
  clientName        String
  scheduledDate     String // YYYY-MM-DD
  scheduledTime     String // HH:MM AM/PM
  priority          String // high, medium, low
  estimatedDuration String

  // How the inspection was carried out. PHYSICAL means the checker was on-site and is
  // geofenced against the vendor's factory; VIRTUAL means it was done online, so no
  // location is captured or validated. Chosen at start. Defaults to PHYSICAL so every
  // inspection created before this field reads as an on-site one.
  inspectionType InspectionType @default(PHYSICAL)

  // Status & Timing
  status      InspectionStatus @default(SCHEDULED)
  startedAt   DateTime?
  completedAt DateTime?

  // Draft / pause / resume. When a checker saves a draft and exits mid-inspection,
  // draftData holds the full in-progress form snapshot and pausedAt marks when the
  // pause began. On resume the elapsed pause gap is added to totalPausedMs and
  // pausedAt is cleared. Together with startedAt/submittedAt these drive the report's
  // active/paused/total duration breakdown. All cleared on completion.
  draftData     Json?
  pausedAt      DateTime?
  totalPausedMs Int       @default(0)

  // Inspection Items (JSON array of category/subcategory objects assigned)
  itemsToInspect Json

  // Results
  result InspectionResult?
  score  Float?
  notes  String?

  // Re-inspection tracking
  parentInspectionId String? @db.ObjectId
  cycleNumber        Int     @default(1)

  // Rejection details (populated when checker submits as failed)
  rejectionReason      String?
  rejectionRemarks     String?
  rejectionNotes       String?
  locationDetails      String?
  rejectionAttachments String[] @default([])

  // Location verification (QC checker GPS vs vendor factory)
  checkerLatitude   Float?
  checkerLongitude  Float?
  vendorLatitude    Float? // Snapshot of vendor factory lat at inspection time
  vendorLongitude   Float? // Snapshot of vendor factory lng at inspection time
  locationVerified  Boolean @default(false)
  locationDistanceM Float? // Distance in meters between checker and vendor
  // Which registered address the checker was verified against: 'legal/factory' | 'warehouse'.
  // The geofence checks whichever applies, so the report can name the exact site.
  locationMatchedAddress String?

  // Review tracking
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?   @db.ObjectId

  // Scheduling lifecycle. reminderSentAt guards the 1-hour-before reminder so
  // the cron sweep never double-notifies. expiredAt stamps when a SCHEDULED
  // assignment blew past its booked window (scheduledDate+time+duration)
  // without the checker starting — see utils/inspectionSchedule.js.
  reminderSentAt DateTime?
  expiredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([vendorId, status, result])
  @@index([checkerId, status])
  @@index([completedAt])
  @@index([parentInspectionId])
  @@map("inspections")
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  UNDER_ADMIN_REVIEW
  REJECTED
  REINSPECTION
  COMPLETED
  CANCELLED
  // Booked window (scheduledDate + scheduledTime + estimatedDuration) elapsed
  // before the checker started. Terminal — frees the vendor for reassignment.
  EXPIRED
}

enum InspectionResult {
  PASSED
  FAILED
}

enum InspectionType {
  PHYSICAL // On-site — checker GPS captured and geofenced against the vendor factory.
  VIRTUAL  // Online — no location capture or validation.
}

// ============================================
// INSPECTION AUDIT TRAIL
// ============================================

model InspectionAuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Polymorphic reference: "FACTORY_INSPECTION" or "PRODUCT_INSPECTION"
  entityType String
  entityId   String @db.ObjectId

  // What happened
  action     String // SUBMITTED, ADMIN_APPROVED, ADMIN_REJECTED, REINSPECTION_RAISED, REINSPECTION_STARTED, REINSPECTION_COMPLETED
  fromStatus String?
  toStatus   String?

  // Who did it
  performedById   String  @db.ObjectId
  performedByType String // ADMIN, QC_CHECKER
  performedByName String?

  // Rejection / review details
  rejectionReason String?
  remarks         String?
  notes           String?
  locationDetails String?
  attachments     String[] @default([]) // Cloudinary URLs
  inspectionData  Json? // Snapshot of form data at this point

  // Re-inspection tracking
  cycleNumber Int     @default(1)
  parentLogId String? @db.ObjectId

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([performedById])
  @@map("inspection_audit_logs")
}

// Generic atomic counter for sequential code generation (vendor, future entities).
// Single-document upserts on MongoDB are atomic, so concurrent registrations
// cannot collide on the same sequence value.
model Counter {
  id    String @id @map("_id") // e.g. "vendor-2026"
  value Int    @default(0)

  @@map("counters")
}

// FCM device tokens for push notifications (mobile + web)
model DeviceToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  role      String // ADMIN, VENDOR, QC_CHECKER, USER
  token     String   @unique
  platform  String // android, ios, web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, role])
  @@map("device_tokens")
}

// In-app notifications (persisted for dropdown UI + history)
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String // recipient's ID (vendorId, adminId, or customerId)
  role      String // ADMIN, VENDOR, USER — determines which dashboard shows it
  type      String // ORDER_RECEIVED, PRODUCT_APPROVED, PAYMENT_RECEIVED, etc.
  title     String
  message   String
  data      Json? // optional metadata (orderId, productId, etc.)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, role, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// ANALYTICS & TRACKING
// ============================================

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  page      String // Page path e.g. "/products", "/checkout"
  userId    String?  @db.ObjectId
  sessionId String?
  referrer  String?
  device    String? // mobile, tablet, desktop
  browser   String?
  duration  Int? // Time spent in seconds
  createdAt DateTime @default(now())

  @@index([page])
  @@index([createdAt])
  @@index([userId])
  @@map("page_views")
}

model ProductView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  productName String?
  category    String?
  userId      String?  @db.ObjectId
  sessionId   String?
  source      String? // "search", "category", "home", "direct"
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([category])
  @@index([productId, sessionId, createdAt])
  @@map("product_views")
}

// ============================================
// PRICE NEGOTIATION
// ============================================

/// One offer in an admin↔vendor price negotiation.
///
/// Append-only: every offer, counter-offer and response is a row, so the
/// product page can render the full timeline ("who proposed what, why, when")
/// without reconstructing it from status changes.
///
/// Negotiation is PRODUCT-level, not variant-level, on purpose: the vendor is
/// paid `Product.basePrice` per line (orderController), and variant prices are
/// not used for settlement. `proposedPercent` lets one agreement scale every
/// variant proportionally instead of forcing a round per variant.
model PriceNegotiation {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId  String  @db.ObjectId
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// 1-based; increments per offer so the timeline orders deterministically
  /// even when two rows share a timestamp.
  round Int

  proposedBy NegotiationParty
  /// Admin id or vendor id — whoever created this row. Plain String, not
  /// @db.ObjectId: this is an audit stamp, not a relation, and the two sides
  /// come from different collections. Constraining it to ObjectId turns any
  /// non-conforming id into a 500 instead of a harmless unlinked stamp.
  proposedById String?

  /// Offered vendor buying price (INR, product level).
  proposedPrice Float
  /// Offered price as a % of the vendor's ORIGINAL asking price. Stored so
  /// variant prices can be scaled by the same factor on acceptance.
  proposedPercent Float?
  /// The price this offer was responding to — lets the UI show "₹200 → ₹150"
  /// per row without walking backwards through the timeline.
  previousPrice Float?

  /// Structured reason code (e.g. MARKET_PRICE_LOWER, BULK_ORDER) plus free text.
  reasonCode String?
  message    String?

  status NegotiationRoundStatus @default(PENDING)

  /// Set when the other side responds to this row.
  respondedAt   DateTime?
  respondedById String?

  /// Offers auto-expire so a silent vendor cannot park a product forever.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, round])
  @@index([vendorId, status])
  @@index([status, expiresAt])
  @@map("price_negotiations")
}

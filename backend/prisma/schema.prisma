// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USER MANAGEMENT
// ============================================

model Admin {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  password          String? // Optional for Google OAuth users
  name              String
  image             String?
  roleId            String?   @db.ObjectId
  role              Role?     @relation(fields: [roleId], references: [id])
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  // Uniqueness is enforced by a PARTIAL unique index (googleId is a string) created manually in MongoDB.
  // A plain @unique here would index null/absent values and block all local (non-Google) signups after the first.
  googleId          String?
  provider          String    @default("local") // "local" or "google"
  lastLogin         DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  verificationToken String?

  // FCM Push Notification Tokens (Multi-device support)
  fcmTokens Json[] @default([]) // Array of { token, device, lastUsed }

  // Additional admin profile fields
  // Structured name parts (compose into `name` for display). Optional so
  // existing records that only have `name` keep working.
  title        String? // Mr / Mrs / Ms / Dr …
  firstName    String?
  middleName   String?
  lastName     String?
  phoneNumber  String?
  address      String?
  addressLine2 String?
  addressLine3 String?
  landmark     String?
  city         String?
  state        String?
  zipCode      String?
  country      String?
  dateOfBirth  DateTime?
  gender       String? // "male" | "female" | "other"
  currency     String?   @default("INR") // Admin's preferred currency

  // Business Information
  companyName String? // Company/Business name
  gstNumber   String? // GST/Tax identification number
  designation String? // Job title / designation (e.g. "Operations Manager")

  // ── Org placement (Phase-1 advanced user management) ──────────────────────
  // Primary department/team and the manager/TL this person reports to. Bare
  // ObjectId scalars (resolved in code). Scoped roles live in RoleAssignment;
  // `roleId` above is kept for back-compat and mirrors the primary assignment.
  departmentId String? @db.ObjectId
  teamId       String? @db.ObjectId
  reportsToId  String? @db.ObjectId // manager/TL in the reporting chain

  // Onboarding Configuration (IMMUTABLE after completion)
  onboardingCompleted Boolean @default(false)

  // Working Hours Configuration
  workingHours WorkingHour[]

  // Maker-checker approval — a newly created staff account is held (cannot log in)
  // until an authorised person approves it.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById   String?   @db.ObjectId
  submittedByName String?
  approvedById    String?   @db.ObjectId
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  // Org rank used for approval routing + escalation (NOT for permissions).
  // Fully custom numeric values, e.g. Staff=10, Team Lead=20, Manager=30,
  // Director=40. Higher = more senior. Defaults to Staff level.
  level       Int      @default(10)
  admins      Admin[]

  // Maker-checker approval — a newly created role is held (cannot be assigned to
  // staff) until an authorised person approves it.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById   String?   @db.ObjectId
  submittedByName String?
  approvedById    String?   @db.ObjectId
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// ── Organisation structure (dynamic tree) ────────────────────────────────────
// Company → Department(s) → Team(s) → people. Arbitrary depth via Department.parentId.
// Cross-links (headId, leadId, reportsToId, memberships) are bare ObjectId scalars
// resolved in code — matching this codebase's convention (e.g. Order.customerId) and
// avoiding heavy Prisma back-relation wiring.
model Department {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String? // short slug e.g. "vendor_mgmt"
  description String?
  parentId    String? @db.ObjectId // sub-department support
  headId      String? @db.ObjectId // the director/head Admin
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("departments")
}

model Team {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  departmentId String  @db.ObjectId
  leadId       String? @db.ObjectId // team lead Admin
  description  String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@map("teams")
}

// A scoped role grant: "this admin has this role, within this scope". One row per
// (admin, department) in practice — one role per department (see plan). GLOBAL scope
// (no department) is for org-wide roles like Super Admin / company Director.
model RoleAssignment {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  adminId      String  @db.ObjectId
  roleId       String  @db.ObjectId
  scopeType    String  @default("GLOBAL") // GLOBAL | DEPARTMENT | TEAM
  departmentId String? @db.ObjectId
  teamId       String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([roleId])
  @@index([departmentId])
  @@map("role_assignments")
}

// ============================================
// WORKFLOW ENGINE (generic multi-stage approvals)
// ============================================
// Fully data-driven. A definition is a reusable template of ordered stages.
// Any subject (Vendor, Product, Order, Refund, …) runs through the SAME engine
// via subjectType + subjectId — nothing about the subject is hardcoded.

// A reusable workflow template, e.g. "Vendor Onboarding", "Product Approval".
model WorkflowDefinition {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String  @unique // stable key e.g. "vendor_onboarding"
  description String?
  subjectType String // VENDOR | PRODUCT | ORDER | REFUND | RETURN | GENERIC | ...
  isActive    Boolean @default(true)
  version     Int     @default(1)

  // How a new instance is started: MANUAL (someone starts it) or EVENT (fired by code).
  trigger     String  @default("MANUAL") // MANUAL | EVENT
  triggerEvent String? // e.g. "vendor.submitted" when trigger = EVENT

  createdById   String? @db.ObjectId
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectType])
  @@index([isActive])
  @@map("workflow_definitions")
}

// One ordered step of a definition.
model WorkflowStage {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  definitionId String @db.ObjectId
  order        Int // 1-based sequence within the definition
  name         String
  description  String?

  // WHO acts at this stage. assigneeType decides which of the target fields matters.
  //   ROLE       -> any admin holding assigneeRoleId (a pool)
  //   DEPARTMENT -> any admin in assigneeDepartmentId (a pool)
  //   TEAM       -> any admin in assigneeTeamId (a pool)
  //   USER       -> a specific admin (assigneeAdminId)
  //   INITIATOR  -> whoever started the instance
  //   DEPT_HEAD  -> the head of the subject/initiator's department
  //   TEAM_LEAD  -> the lead of the initiator's team
  //   DYNAMIC    -> assignee chosen at runtime by a prior stage's ASSIGN action
  assigneeType         String  @default("ROLE")
  assigneeRoleId       String? @db.ObjectId
  assigneeDepartmentId String? @db.ObjectId
  assigneeTeamId       String? @db.ObjectId
  assigneeAdminId      String? @db.ObjectId
  // For DYNAMIC: which earlier stage's ASSIGN picks this stage's assignee.
  assignedByStageOrder Int?

  actions String[] // allowed actions: APPROVE, REJECT, ASSIGN, SUBMIT, REQUEST_CHANGES

  // Routing. Values: "NEXT" | "COMPLETE" | "PREVIOUS" | "INITIATOR" | "REJECT_END" | "<order:N>".
  onApprove String @default("NEXT") // where an approve/submit goes
  onReject  String @default("REJECT_END") // where a reject goes (configurable)

  requiresComment Boolean @default(false)
  allowReassign   Boolean @default(true)
  slaHours        Int? // optional SLA for escalation (Phase 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([definitionId, order])
  @@map("workflow_stages")
}

// One live run of a definition against a specific subject.
model WorkflowInstance {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  definitionId   String @db.ObjectId
  definitionCode String // denormalized for quick lookup
  name           String // snapshot of definition name at start

  subjectType  String
  subjectId    String  @db.ObjectId
  subjectLabel String? // human label for inbox/timeline e.g. "Acme Traders"

  status            String @default("ACTIVE") // ACTIVE | COMPLETED | REJECTED | CANCELLED
  currentStageId    String? @db.ObjectId
  currentStageOrder Int     @default(0)

  initiatedById   String? @db.ObjectId
  initiatedByName String?

  // Runtime overrides: assignees chosen by ASSIGN actions, keyed by target stage order.
  // e.g. { "4": "<adminId>" } means stage 4 is assigned to that admin.
  dynamicAssignees Json?
  data             Json? // arbitrary context payload

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([subjectType, subjectId])
  @@index([status])
  @@index([definitionId])
  @@map("workflow_instances")
}

// A pending (or resolved) unit of work sitting in someone's inbox.
model WorkflowTask {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  instanceId   String @db.ObjectId
  definitionId String @db.ObjectId
  stageId      String @db.ObjectId
  stageName    String
  stageOrder   Int

  // Resolved target of this task (pool or specific person).
  assigneeType         String
  assigneeRoleId       String? @db.ObjectId
  assigneeDepartmentId String? @db.ObjectId
  assigneeTeamId       String? @db.ObjectId
  assigneeAdminId      String? @db.ObjectId

  actions String[] // allowed actions for this task

  // Denormalized subject info so the inbox needs no joins.
  subjectType  String
  subjectId    String  @db.ObjectId
  subjectLabel String?

  status      String  @default("PENDING") // PENDING | DONE | SKIPPED | CANCELLED
  actionTaken String? // APPROVE | REJECT | ASSIGN | SUBMIT | REQUEST_CHANGES
  actedById   String? @db.ObjectId
  actedByName String?
  comment     String?
  actedAt     DateTime?

  dueAt     DateTime? // SLA deadline
  // Escalation (Phase 4): when a task blows its SLA, the sweep escalates it to
  // the assignee's manager/dept-head and remembers where it came from.
  escalated               Boolean @default(false)
  escalationLevel         Int     @default(0)
  originalAssigneeAdminId String? @db.ObjectId
  escalatedAt             DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, assigneeAdminId])
  @@index([status, assigneeRoleId])
  @@index([status, assigneeDepartmentId])
  @@index([status, assigneeTeamId])
  @@index([status, dueAt])
  @@index([instanceId])
  @@map("workflow_tasks")
}

// Immutable audit trail of everything that happened on an instance.
model WorkflowHistory {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  instanceId String @db.ObjectId
  stageId    String? @db.ObjectId
  stageName  String?
  stageOrder Int?

  action    String // STARTED | APPROVE | REJECT | ASSIGN | SUBMIT | REQUEST_CHANGES | COMPLETED | CANCELLED | ESCALATED
  actorId   String? @db.ObjectId
  actorName String?
  comment   String?

  fromStageOrder Int?
  toStageOrder   Int?
  meta           Json?

  createdAt DateTime @default(now())

  @@index([instanceId, createdAt])
  @@map("workflow_history")
}

// Delegation (Phase 4): "cover my tasks while I'm away." Any task directly
// assigned to fromAdminId is also actionable by toAdminId while the delegation
// is active and within its date window.
model WorkflowDelegation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  fromAdminId String   @db.ObjectId
  fromName    String?
  toAdminId   String   @db.ObjectId
  toName      String?
  reason      String?
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toAdminId, isActive])
  @@index([fromAdminId, isActive])
  @@map("workflow_delegations")
}

model WorkingHour {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String  @db.ObjectId
  day       String // "Monday", "Tuesday", etc.
  enabled   Boolean @default(true)
  startTime String // "00:00" format
  endTime   String // "23:59" format

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, day])
  @@map("working_hours")
}

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  password          String? // Optional for Google OAuth users
  name              String
  image             String?
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  // Uniqueness is enforced by a PARTIAL unique index (googleId is a string) created manually in MongoDB.
  // A plain @unique here would index null/absent values and block all local (non-Google) signups after the first.
  googleId          String?
  provider          String    @default("local") // "local" or "google"
  lastLogin         DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  verificationToken String?

  // Additional user profile fields
  title          String?
  middleName     String?
  whatsappNumber String?
  phoneNumber  String?
  address      String?
  addressLine2 String?
  city         String?
  state        String?
  zipCode      String?
  country      String?
  dateOfBirth  DateTime?
  gender       String? // "male" | "female" | "other"

  // Multiple addresses support
  addresses Address[]
  reviews   Review[]
  experienceReviews ExperienceReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         String // home, work, other
  typeLabel    String? // office/company name (work) or custom label (other)
  name         String?
  phone        String?
  phone2       String? // optional secondary mobile (E.164)
  landline     String? // optional landline (free-form, digits/space/dash)
  address      String
  addressLine2 String?
  addressLine3 String?
  landmark     String?
  city         String
  state        String
  zipCode      String
  country      String
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// ============================================
// CART & WISHLIST
// ============================================

model Cart {
  id     String     @id @default(auto()) @map("_id") @db.ObjectId
  userId String     @db.ObjectId
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String  @db.ObjectId
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  variantId String? @db.ObjectId
  quantity  Int     @default(1)
  price     Float // Store price at time of adding to cart
  currency  String  @default("INR") // INR or USD
  // Shipping mode the customer picked for this line: "AIR" | "SHIP".
  // Required before checkout whenever the product offers a choice, because AIR and
  // SHIP have different per-kg rates and delivery windows (Product.logisticsConfig).
  // Null when the product has no logistics config, or exactly one transport type
  // (nothing to choose — the server resolves it).
  transportType String?
  // Courier partner the customer picked for this line (catalog id, e.g. "blue-dart").
  // Region- and mode-specific: domestic couriers on .in, international on .com; the
  // choices depend on transportType (AIR vs SHIP). See utils/couriers.js.
  courier String?

  // Free gift line, granted by a CROSS "Buy A get B free" offer. Priced at 0, its
  // quantity is fixed by the offer, and the server removes it automatically when the
  // buy condition is no longer met. `giftOfferId` is the Offer that granted it.
  isFreeGift  Boolean @default(false)
  giftOfferId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

model Wishlist {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  userId     String         @unique @db.ObjectId
  shareToken String?
  items      WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shareToken])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  wishlistId String   @db.ObjectId
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ============================================
// VENDOR MANAGEMENT
// ============================================

model Vendor {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  vendorCode String? @unique // Human-readable code, format VND-YYYY-NNNN
  email      String  @unique
  password   String?

  // Password Reset Fields
  resetToken       String?
  resetTokenExpiry DateTime?

  // Application Status
  status               VendorStatus @default(PENDING)
  rejectionReason      String?
  rejectionRequestedBy String? // Admin/Employee ID who requested the rejection
  rejectionRequestedAt DateTime? // When rejection was requested
  approvalRequestedBy  String? // Admin/Employee ID who requested the approval
  approvalRequestedAt  DateTime? // When approval was requested
  approvedAt           DateTime?
  rejectedAt           DateTime?
  suspendedAt          DateTime?
  // Registration-form review (staff gate before QC assignment)
  reviewedBy           String? // Admin ID who reviewed the registration form
  reviewedByName       String?
  reviewedAt           DateTime?
  reviewNote           String? // staff's qualification note

  // Owner Profile
  ownerName        String
  // Owner's designation — Proprietor / CEO / Director / Managing Director /
  // Founder / custom "Other" string. Optional because legacy rows pre-date
  // this field; new submissions enforce it on the frontend.
  designation      String?
  ownerEmail       String
  ownerEmail2      String? // Optional secondary owner email
  ownerPhone       String
  ownerPhone2      String? // Optional secondary owner phone (E.164)
  ownerLandline         String? // Local landline assembled (STD+number, India +91)
  ownerLocalLandlineStd String? // STD / area code part of local landline
  ownerIntlLandline     String? // International landline assembled (dial+std+number)
  // Owner address — nullable because the registration form does NOT
  // collect a separate owner address (it shares the business address).
  // The Vendor Settings page lets vendors edit these post-approval; until
  // then they're left null rather than fake-copying the business address.
  ownerAddress     String?
  ownerCity        String?
  ownerState       String?
  ownerZipCode     String?
  ownerCountry     String?
  ownerPhoto       String? // Cloudinary URL
  // Array of additional owners / directors / partners (Step 3). Each entry
  // is currently the minimal shape `{ name, email, phone }`. Note the
  // ASYMMETRY: the primary owner above has 9+ fields (designation, email2,
  // phone2, landline, customDesignation, customDepartment, etc.). The
  // additional-contact UI on Step 3 only collects the basics — enrich both
  // the FE form and this JSON shape together if the team wants parity.
  additionalOwners Json?
  // When the business started — captured as a full date on Step 3.
  // `establishedYear` below is derived from this on the backend for
  // backward-compat with code that still reads year-only.
  businessStartDate DateTime?
  // Employee head-count range chip from Step 3 (e.g. "10-20", "50-100").
  // String — the form collects ranges, not exact integers. Replaces the
  // previous "stuff this into annualTurnover" hack the audit removed.
  employeeCount    String?

  // Company Details
  companyName        String
  companyType        CompanyType
  // Raw business STRUCTURE selected on Step 1 (proprietorship / pvt-ltd /
  // partnership-firm / llp / others / <custom-others-text>). Distinct from
  // `companyType` above, which is the vendor ROLE enum (manufacturer / trader
  // / etc.). Both are needed: structure drives the regulatory-ID label
  // (CIN vs IEC vs Deed vs LLPIN) and the type-specific cert upload; role
  // drives the vendor-flow logic.
  businessType       String?
  // Derived from `businessStartDate` (Owner Profile step) at write time.
  // Made nullable because not every submission carries a parseable date,
  // and the previous non-null constraint was silently breaking registration.
  establishedYear    Int?
  companyDescription String?
  companyLogo        String? // Cloudinary URL
  // gstNumber is enforced unique via a MongoDB SPARSE unique index created by
  // scripts/createGstIndex.js — Prisma's MongoDB connector cannot express
  // sparse indexes in the schema, so the constraint lives at the DB layer.
  gstNumber          String? // GST/Tax identification number — unique key for registered vendors
  // Type-specific regulatory ID — IEC (proprietorship) / CIN (Pvt Ltd) /
  // Partnership Deed details / LLPIN. Optional because "Other" businessType
  // values skip this in the frontend validation.
  companyIdNumber    String?
  // IEC (Import Export Code) — optional, available for every business type.
  iecCode            String?
  // PAN Number — required for the 4 supported business types in the form,
  // optional at the column level so "Other" submissions still persist.
  panNumber          String?
  // Aadhaar Number — required only for the "Unregistered Vendor" business
  // type (which has no GST/PAN). Optional at the column level for all others.
  aadhaarNumber      String?
  // Factory ownership type — owned / rented / lease. Distinct from the
  // warehouse `ownershipType` column above; mirrored to it when the vendor
  // ticks "Same as warehouse" in CompanyDetails.
  factoryOwnershipType String?

  // Acquisition — how the vendor found M2C. Asked on the last registration step
  // so admins can report on which channels actually bring vendors in.
  // Plain String (not a Prisma enum) because the list is frontend-driven and an
  // "others" answer stores free text; enums also have no cheap MongoDB migration
  // path for the legacy rows that pre-date this field. Values:
  // google | online-ads | linkedin | instagram | facebook | youtube |
  // referral | trade-show | others
  referralSource       String?
  // Free text: the referrer's name when referralSource is 'referral', or the
  // typed channel when 'others'. Kept separate so the report groupBy stays a
  // clean low-cardinality key instead of splintering into a long tail.
  referralSourceDetail String?

  // Contact & Trade Information
  businessPhone   String
  landlineNumber  String? // Local landline assembled (STD+number, India +91)
  localLandlineStd String? // STD / area code part of local landline
  intlLandline    String? // International landline assembled (dial+std+number)
  phoneNumber2    String?
  businessEmail   String
  businessEmail2  String? // Optional secondary contact email
  businessAddress String
  // Optional address detail lines collected on the Company Details step.
  // Line 2 / Line 3 cover apartment, suite, floor, building name etc.;
  // landmark is a free-form nearby reference for delivery.
  addressLine2    String?
  addressLine3    String?
  landmark        String?
  businessCity    String
  businessState   String
  businessZipCode String
  businessCountry String  @default("India")
  website         String?

  // Trade Information
  // annualTurnover is nullable because the registration form doesn't collect
  // it — the controller previously stuffed `employeeCount` ("10-20" etc.)
  // into this column as a proxy, which was semantic nonsense. Leave null
  // until a real turnover input exists.
  annualTurnover   String?
  // Import / export experience flags. The form currently asks one combined
  // `hasImportExport` yes/no question but maintains separate import + export
  // country lists. We derive each flag from "yes flag OR list non-empty" so
  // a vendor who lists countries without ticking the box still gets flagged.
  // When the FE splits the question, both columns are already in place.
  importExperience Boolean  @default(false)
  exportExperience Boolean  @default(false)
  exportCountries  String[] @default([])
  // Countries the vendor imports from. Previously collected by the form
  // and destructured by the backend but never persisted; added now so the
  // data flows through end-to-end.
  importCountries  String[] @default([])
  primaryMarkets   String[] @default([])

  // Manufacturing Facilities
  enabledFacilities  Json? // { spinning: true, weaving: false, ... }
  // Per-facility detail map. Keys are facility ids (spinning / weaving /
  // dyeing / printing / stitching / finishing); values are objects whose
  // fields are themselves prefixed by the facility id — e.g.
  // { spinning: { spinningMachines: '10', spinningCapacity: '500', remarks: '...' } }.
  // `productionCapacity` (string column) is derived from the *Capacity
  // fields of enabled facilities at write time.
  facilityDetails    Json?
  // Factory address — the registration form treats factory + warehouse as
  // the same physical location, so the controller mirrors warehouse values
  // into these columns. The QC checker app reads these fields directly
  // (qcCheckerController/checker_app), so they're load-bearing.
  factoryAddress     String?
  factoryCity        String?
  factoryState       String?
  factoryZipCode     String?
  factoryCountry     String? @default("India")
  factorySize        String? // e.g., "10000 sq ft" — read by admin + checker UIs
  productionCapacity String? // e.g., "1000 units/month"
  qualityControl     String? // Quality control measures

  // Warehouse Details
  ownershipType    String? // owned, rented, lease
  warehouseAddress String?
  // Optional warehouse address detail lines collected on Step 2. Mirror the
  // company-address shape (addressLine2 / addressLine3 / landmark) so the
  // "Same as warehouse" linker in CompanyDetails can copy them through.
  warehouseAddressLine2 String?
  warehouseAddressLine3 String?
  warehouseLandmark     String?
  warehouseCity    String?
  warehouseState   String?
  warehouseZipCode String?
  warehouseCountry String? @default("India")
  warehouseSize    String?
  storageCapacity  String?
  mapLink          String? // Google Maps embed link
  /// Coordinates of the LEGAL ADDRESS & FACTORY SITE — entered directly on the
  /// registration/admin form. These are the authoritative factory coordinates and the
  /// ones the QC geofence measures against (utils/locationUtils.verifyCheckerAtVendor).
  /// A `mapLink` can still back-fill them, but a value typed by a human always wins.
  factoryLatitude  Float?
  factoryLongitude Float?
  /// Coordinates of the WAREHOUSE address.
  warehouseLatitude  Float?
  warehouseLongitude Float?
  /// Where this vendor's PRODUCTS are physically handled/stored — the site(s) a QC
  /// PRODUCT inspection is geofenced against. Values: 'FACTORY' = Legal Address &
  /// Factory Site (factoryLatitude/Longitude), 'WAREHOUSE' = warehouse
  /// (warehouseLatitude/Longitude). The vendor may pick BOTH — a product inspection
  /// then passes when the checker is within range of EITHER site.
  ///   • productInspectionSites — the authoritative multi-select array.
  ///   • productInspectionSite  — legacy single value kept in sync (= first of the
  ///     array) so older read paths keep working; new logic reads the array.
  productInspectionSites String[] @default(["FACTORY"])
  productInspectionSite  String?  @default("FACTORY")

  // Vendor Type & Products
  vendorType        VendorType
  // Raw multi-select values from the Step 4 form (manufacturer / importer /
  // exporter). `vendorType` above stays as the primary enum for legacy code;
  // `vendorTypes` carries the full FE array so multi-select isn't lossy.
  vendorTypes       String[]   @default([])
  productCategories String[]   @default([])
  productTypes      String[]   @default([])
  specializations   String[]   @default([])
  categoryRemarks   String? // Additional remarks about product categories
  // Per-category product entries collected on Step 4 — each entry has a
  // product name + up to 5 photo URLs (Cloudinary, after upload). Stored
  // as JSON to keep the nested shape together; admin UIs render it as-is.
  categoryProducts     Json?
  // User-defined custom categories created on Step 4 ("Other" path) —
  // same shape as categoryProducts but the category itself is not in the
  // master Category collection.
  additionalCategories Json?

  // Certifications & Logistics
  certifications VendorCertification[]
  documents      VendorDocument[]

  // Logistics Information
  shippingMethods      String[] @default([])
  deliveryTime         String? // e.g., "7-15 days"
  minimumOrderQuantity String?
  paymentTerms         String[] @default([])
  // Step 6 (Certifications & Logistics) free-text fields. Previously the
  // controller destructured these but never persisted them — values went
  // straight to /dev/null. Stored as optional strings.
  packagingCapabilities String?
  logisticsPartners     String?
  complianceStandards   String?

  // Contact & Trade Information
  mainContact                Json? // Main contact person details
  alternateContacts          Json[]  @default([]) // Array of alternate contacts
  tradeLicenseNumber         String?
  businessRegistrationNumber String?
  taxIdentificationNumber    String?

  // Additional Information
  bankDetails VendorBankDetails?

  /// Price negotiations raised against this vendor's products.
  priceNegotiations PriceNegotiation[]
  references  VendorReference[]
  inventory   Inventory[]
  products    Product[]

  // Quality Checker Assignment
  assignedQcId String?      @db.ObjectId
  assignedQc   QCChecker?   @relation("VendorQCChecker", fields: [assignedQcId], references: [id])
  assignedQcAt DateTime?
  inspections  Inspection[]
  settlements  Settlement[]

  // Admin delivery rating aggregates — recomputed whenever an admin submits a
  // review on a vendor-to-hub order. `rating` is the average over all admin
  // reviews scored for this vendor (1-5); `ratingCount` is the sample size.
  rating       Float?
  ratingCount  Int           @default(0)
  adminReviews AdminReview[]

  // Order-acceptance aggregates — updated each time the vendor accepts an order.
  // `avgAcceptanceMins` is the rolling average time-to-accept (minutes), kept as
  // total/count so it updates incrementally without rescanning shipments.
  acceptedOrdersCount Int    @default(0)
  totalAcceptanceMins Float  @default(0)
  avgAcceptanceMins   Float?

  // System fields
  applicationStep Int       @default(1) // Current step in application process
  completedSteps  Int[]     @default([]) // Array of completed step numbers
  submittedAt     DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedQcId, status])
  @@index([assignedQcId, submittedAt])
  @@index([assignedQcId, assignedQcAt])
  @@index([status])
  @@map("vendors")
}

model VendorCertification {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @db.ObjectId
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name              String // e.g., "ISO 9001", "GOTS", "OEKO-TEX"
  // Issuing authority. Nullable because the registration form doesn't
  // collect a per-cert issuer — previously the backend hardcoded the
  // string "Certification Authority" (meaningless noise). Use `isCustom`
  // to distinguish vendor-declared certs from catalog ones instead.
  issuedBy          String?
  certificateNumber String?
  issuedDate        DateTime?
  expiryDate        DateTime?
  documentUrl       String? // Cloudinary URL
  // Free-form description for user-defined "Other" certifications added on
  // Step 6. Empty for catalog certs (OEKO-TEX, GOTS, etc.).
  description       String?
  // True when the vendor created this certification entry themselves via
  // the "Add custom certification" path. Useful for admin filtering and
  // for distinguishing user-supplied data from canonical catalog certs.
  isCustom          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_certifications")
}

model VendorDocument {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @db.ObjectId
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type        DocumentType
  name        String
  documentUrl String // Cloudinary URL
  uploadedAt  DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_documents")
}

model VendorBankDetails {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @unique @db.ObjectId
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  bankName          String
  accountNumber     String
  // India-specific routing code. Nullable because international vendors
  // submit SWIFT/BIC + IBAN instead, and the registration form doesn't
  // collect IFSC. Previously the controller was stuffing `swiftCode` into
  // this column with a fake `SWIFT000` fallback when missing.
  ifscCode          String?
  // SWIFT/BIC code — 8 or 11 chars, used for international wire transfers.
  swiftCode         String?
  // IBAN — used by European/Middle Eastern banking. Up to 34 chars.
  iban              String?
  accountType       String? // Savings, Current, etc. Nullable — FE doesn't collect this.
  accountHolderName String? // Nullable — FE doesn't collect this on Step 7 yet.
  // The legal entity that owns the account — defaults to the vendor's registered
  // company name. Vendors see it read-only; admins may edit it.
  legalEntity       String?
  branchName        String?
  branchAddress     String?

  // Verification status
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String? // Admin ID who verified

  // Manual penny-drop verification handshake before final approval:
  //   PENDING       — submitted, awaiting admin to send the test amount
  //   AMOUNT_SENT    — admin sent a test amount, awaiting vendor confirmation
  //   RECEIVED       — vendor confirmed receipt, awaiting admin final approval
  //   NOT_RECEIVED   — vendor reported not received, admin must resend
  //   VERIFIED       — admin finally approved (isVerified = true)
  verificationStatus String    @default("PENDING")
  amountSentAt       DateTime? // when the admin last sent a test amount
  vendorRespondedAt  DateTime? // when the vendor last responded (received / not)
  verificationNote   String?   // admin's note when sending (e.g. amount + UTR ref)
  vendorNote         String?   // vendor's note with their response (e.g. why not received)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_bank_details")
}

model VendorReference {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @db.ObjectId
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  companyName   String
  contactPerson String
  email         String
  phone         String
  relationship  String // e.g., "Client", "Supplier", "Partner"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_references")
}


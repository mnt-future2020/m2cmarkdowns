// ============================================
// PRODUCT MANAGEMENT
// ============================================

model Product {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @db.ObjectId
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Inventory Connection
  inventoryItemId String?    @db.ObjectId
  inventory       Inventory? @relation("InventoryProducts", fields: [inventoryItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  isFromInventory Boolean    @default(false)

  // Basic Information
  name        String
  slug        String? @unique
  description String
  category    String
  subCategory String?

  // Pricing Information
  basePrice     Float
  originalPrice Float?
  discount      Float?
  gstPercentage Float? // GST Percentage for the product
  hsnCode       String? // HSN / SAC code for GST classification (e.g. "6302")

  // Whether the customer can raise a return for this product (within 7 days of
  // delivery). When false, the return option is hidden for this product on the
  // storefront. Defaults to true so existing products stay returnable.
  returnable Boolean @default(true)

  // How the product ships. `packagingType` = 'PACKED' | 'UNPACKED'. When PACKED,
  // `packingType` = 'BALE' | 'CARTON' (the pack style); it stays null for UNPACKED.
  packagingType String? // 'PACKED' | 'UNPACKED'
  packingType   String? // 'BALE' | 'CARTON' — only when packagingType = 'PACKED'
  unpackedType  String? // 'STITCHED' | 'UNSTITCHED' | 'OTHER' — only when packagingType = 'UNPACKED'
  unpackedNote  String? // Free-text remark for the unpacked selection (esp. 'OTHER')

  // Single Unit Pricing Configuration
  singleUnitSize     String?
  singleUnitColor    String?
  singleUnitColorHex String?

  // Product Rating & Reviews
  rating  Float?
  reviews Int?   @default(0)

  // Fabric & Specifications
  fabricType           String?
  material             String?
  fabricSpecifications Json? // FabricSpecification object

  // Who actually MADE this item (distinct from the Vendor, who sells it). Entered by the
  // vendor on the product form and shown on every product/inspection surface.
  // Shape: { photo, title, fullName, role, experience, description }. `photo` is a
  // Cloudinary URL (the base64 upload is resolved on save, like the product images).
  manufacturerInfo Json?

  // Variants Management
  variants    ProductVariant[]
  hasVariants Boolean          @default(false)

  // Base Product Info
  // Auto-generated, immutable, globally unique: [COMPANY_CODE]-[YY]-[SERIAL].
  baseSku String @unique
  // Last variant suffix issued for this product (1 → A, 2 → B …). Only ever
  // increments so deleted-variant suffixes are never reused.
  variantSeq Int @default(0)

  // Images
  images      ProductImage[]
  reviewsList Review[]       @relation("ProductReviews")

  // Stock Management
  totalStock        Int     @default(0)
  lowStockThreshold Int     @default(10)
  trackInventory    Boolean @default(true)

  // Dispatch & Shipping
  dispatchTimeline Json // DispatchTimeline object

  // Additional Info
  uom        String   @default("pcs") // Unit of Measurement: pcs, meters, kg, yards, sets, rolls
  tags       String[] @default([])
  dimensions  String?
  weight      String?
  weightUnit  String?
  inStock     Boolean  @default(true)

  // Logistics Configuration (per-product transport, weight rules, costs)
  logisticsConfig Json? // LogisticsConfig object

  // Product Status & Approval
  status           ProductStatus         @default(ACTIVE)
  approvalStatus   ProductApprovalStatus @default(PENDING)
  approvedAt       DateTime?
  approvedBy       String?               @db.ObjectId // Admin ID who approved
  rejectionReason  String?
  adminFixedPrice  Float? // Admin can override the vendor's base price
  priceINR         Float? // Admin selling price in INR (for .in domain)
  priceUSD         Float? // Admin selling price in USD (for .com domain)
  originalPriceINR Float? // Original/MRP price in INR (for strikethrough)
  originalPriceUSD Float? // Original/MRP price in USD (for strikethrough)
  priceVisibility  PriceVisibility       @default(BOTH) // Controls which domain shows this product: IN_ONLY (.in), COM_ONLY (.com), BOTH

  assignedQcId     String?    @db.ObjectId
  assignedQc       QCChecker? @relation("ProductQCChecker", fields: [assignedQcId], references: [id])
  qcInspectionData Json? // Stores the product inspection form data
  // Scheduling captured when the admin assigns a QC checker to this product — mirrors
  // the factory Inspection's schedule fields (products have no separate Inspection row).
  // Shape: { clientName, scheduledDate (YYYY-MM-DD), scheduledTime (HH:MM), priority, estimatedDuration }.
  qcAssignment     Json?

  // ── Price negotiation ──────────────────────────────────────────────
  // The vendor's buying price agreed with the admin. Null until a
  // negotiation closes; once set it becomes the vendor's payout price
  // (orderController pays `basePrice`, so accepting an offer writes the
  // agreed figure into basePrice and mirrors it here for audit).
  // `basePriceOriginal` keeps what the vendor first asked, so the admin
  // panel can always show "asked X → agreed Y".
  agreedPrice       Float?
  basePriceOriginal Float?
  negotiations      PriceNegotiation[]

  // Re-inspection tracking
  inspectionCycleNumber  Int       @default(1)
  previousInspectionData Json[]    @default([]) // Array of past qcInspectionData snapshots
  lastReviewedBy         String?   @db.ObjectId
  lastReviewedAt         DateTime?
  rejectionRemarks       String?
  rejectionNotes         String?
  rejectionAttachments   String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus])
  @@index([status])
  @@index([vendorId])
  @@index([createdAt])
  @@index([approvalStatus, status, createdAt])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantName      String?         // Optional human label for the variant
  size             String?         // Optional
  color            String
  colorHex         String?
  sku              String          @unique
  price            Float // Vendor's price
  originalPrice    Float? // Original price before discount
  discount         Float? // Discount percentage
  adminFixedPrice  Float? // Admin's fixed price for this variant
  priceINR         Float? // Admin selling price in INR for this variant
  priceUSD         Float? // Admin selling price in USD for this variant
  originalPriceINR Float? // Original price in INR for this variant
  originalPriceUSD Float? // Original price in USD for this variant
  priceVisibility  PriceVisibility @default(BOTH) // Controls which domain shows this variant
  stock            Int             @default(0)
  lowStockThreshold Int?           // Per-variant low-stock alert level; falls back to the product/inventory min stock when null
  images           String[]        @default([]) // Array of image URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String
  isPrimary Boolean @default(false)
  imageType String  @default("gallery") // "cover" or "gallery"
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isPrimary])
  @@map("product_images")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ProductApprovalStatus {
  PENDING
  // The QC checker has finished inspecting and SUBMITTED the report. The
  // checker's recommendation (Approved / Rejected / Re-Inspection) is advisory
  // only and lives in qcInspectionData.inspectionStatus — the ADMIN makes the
  // final call (approve / reject / re-inspection) from this state. Mirrors the
  // vendor/factory inspection SUBMITTED → admin-review flow.
  QC_SUBMITTED
  QC_APPROVED
  APPROVED
  REJECTED
  REINSPECTION
  // Admin and vendor are agreeing the vendor's buying price. Sits between
  // QC_APPROVED and APPROVED. Deliberately ONE status: who moved last and
  // what was offered lives on PriceNegotiation rows, not here — adding a
  // status per negotiation step would force every product filter, badge and
  // index in the app to learn six new values for no gain.
  NEGOTIATION
}

/// Which side made a given negotiation offer.
enum NegotiationParty {
  ADMIN
  VENDOR
}

/// Lifecycle of a single negotiation round (one offer).
enum NegotiationRoundStatus {
  PENDING // awaiting the other side's response
  ACCEPTED // other side accepted this offer — negotiation closes
  REJECTED // other side rejected outright — negotiation closes
  COUNTERED // other side replied with a new price (superseded by the next round)
  EXPIRED // no response within the expiry window
  CANCELLED // withdrawn (e.g. product re-inspected mid-negotiation)
}

enum PriceVisibility {
  IN_ONLY
  COM_ONLY
  BOTH
}

// ============================================
// ORDER MANAGEMENT SYSTEM
// ============================================

model Order {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @unique // Human readable order ID (e.g., ORD-2024-001)
  invoiceNo String? // Invoice number per InvoiceSettings (e.g., INV-2024-25-0001)

  // Customer Information
  customerId    String? @db.ObjectId
  customerName  String
  customerEmail String
  customerPhone String

  // Shipping Address
  shippingAddress Json // Complete address object

  // Order Items
  items OrderItem[]

  // Pricing
  subtotal     Float
  shippingCost Float   @default(0) // weight-based rate + delivery-zone flat fee (pre-tax)
  tax          Float   @default(0) // Total GST = cgst + sgst + igst
  discount     Float   @default(0)
  totalAmount  Float
  couponCode   String?

  // ── Delivery zone + shipping tax (destination-based) ──────────────────────
  deliveryZoneId   String? @db.ObjectId // matched zone (null for legacy orders)
  deliveryZoneName String?
  deliveryFlatFee  Float   @default(0) // the zone's flat fee portion of shippingCost
  shippingTax      Float   @default(0) // GST charged on shippingCost (order currency)
  shippingTaxINR   Float?  // INR twin of shippingTax

  // GST split (India / `.in` only). Determined by comparing the Admin/Company
  // registered State (supplier) with the customer's shipping State (place of
  // supply): same state = intrastate (CGST+SGST), different = interstate (IGST).
  // These are display fields — `tax` remains the authoritative total. All 0 /
  // null when no GST applies (non-`.in` regions).
  cgstAmount Float   @default(0)
  sgstAmount Float   @default(0)
  igstAmount Float   @default(0)
  taxType    String? // 'INTRASTATE' | 'INTERSTATE' | null

  // Currency
  currency String @default("INR") // INR or USD
  // Snapshot of ExchangeRate.rate (INR per 1 USD) at the moment of purchase.
  // ExchangeRate holds a single mutable row per currency, so it CANNOT be used to
  // convert a past order — admin edits would silently rewrite historical amounts.
  // Null on pre-snapshot orders and on INR orders, where no conversion applies.
  exchangeRate Float?

  // INR-normalised twins of the money fields above, frozen at write time using
  // exchangeRate. For INR orders these equal their originals. Reports and every
  // cross-order aggregate MUST sum these, never the originals — the originals are
  // mixed-currency, so SUM(totalAmount) adds $10 to ₹500 and returns 510.
  // See utils/orderCurrency.js. Null means "not convertible", never zero.
  totalAmountINR  Float?
  taxINR          Float?
  shippingCostINR Float?
  discountINR     Float?

  // Wallet store-credit applied at checkout (a tender, NOT a price/tax adjustment).
  // walletApplied is in the order currency; walletAppliedINR is the INR twin actually
  // debited from the wallet. amountPaid is what the gateway was charged (order currency).
  walletApplied    Float? @default(0)
  walletAppliedINR Float?
  amountPaid       Float?

  // Credit Points redeemed at checkout (also a tender, like walletApplied).
  // pointsRedeemed = number of points spent; pointsRedeemedValue = their money value
  // in the order currency; pointsRedeemedValueINR = the INR twin. pointsEarned is set
  // once (on DELIVERED by default) so earning is idempotent and reversible.
  pointsRedeemed         Int?   @default(0)
  pointsRedeemedValue    Float? @default(0)
  pointsRedeemedValueINR Float? @default(0)
  pointsEarned           Int?   @default(0)
  pointsEarnedAt         DateTime?
  // Set when an order's points movements (earn + redeem) have been reversed on
  // cancel/return, so the reversal is applied at most once.
  pointsReversedAt       DateTime?

  // Payment Information
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentId     String?

  // Order Status & Tracking
  // NOTE: status is now a computed aggregate of all VendorShipment statuses.
  // It is persisted for backward compatibility and efficient queries.
  status            OrderStatus @default(ORDER_CREATED)
  trackingReference String? // Customer-facing tracking ID entered at ship-to-customer time
  // Courier partner (DB Courier id) chosen for the final hub→customer leg.
  courier           String?

  // ── Cancellation / Return / Refund ──────────────────────────────────────
  cancelReason  String? // Reason the customer/admin gave when cancelling
  // Customer return request (raised after delivery; admin approves/rejects).
  // Shape: { reason, status: 'Requested'|'Approved'|'Rejected', requestedAt, decidedAt, note }
  returnRequest Json?
  // Gateway refund tracking. refundStatus: 'INITIATED'|'PROCESSED'|'FAILED'|'MANUAL'|'NONE'
  refundId      String?
  refundStatus  String?
  refundAmount  Float?

  // DEPRECATED: Vendor shipping details now live on VendorShipment.
  // Retained for backward compatibility with pre-migration orders.
  vendorCarrier    String?
  vendorTrackingId String?
  vendorShippedAt  DateTime?
  assignedHubId    String?   @db.ObjectId
  hub              Hub?      @relation(fields: [assignedHubId], references: [id])

  // Vendor Information (for single vendor orders)
  vendorId String? @db.ObjectId

  // Vendor Shipments (one per vendor in this order)
  shipments VendorShipment[]

  // Admin Hub Processing
  adminReview AdminReview[]

  // Status History
  statusHistory OrderStatusHistory[]
  reviews       Review[]
  experienceReviews ExperienceReview[]
  settlements   Settlement[]

  // Timestamps
  orderDate         DateTime  @default(now())
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([assignedHubId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product Information
  productId    String  @db.ObjectId
  productName  String
  productImage String?

  // Variant Information (if applicable)
  variantId String? @db.ObjectId
  size      String?
  color     String?
  sku       String

  // Pricing & Quantity
  quantity   Int
  unitPrice  Float
  totalPrice Float
  // Customer GST rate (%) actually charged on this line, frozen at checkout from
  // the product's own gstPercentage — so the invoice prints the real per-item
  // rate (e.g. 5% vs 12%) rather than a blended average. Null on legacy rows.
  gstPercentage Float?
  // INR-normalised twin of totalPrice, frozen at write time from the parent order's
  // exchangeRate. OrderItem has no currency column of its own — it inherits the
  // parent Order's — so product/vendor/category revenue groupBys cannot even filter
  // by currency without a join. They aggregate this instead. See utils/orderCurrency.js.
  totalPriceINR Float?
  // Shipping mode this line was actually charged and must be dispatched by.
  // Snapshotted from the cart so warehouse/fulfilment sees what the customer paid for.
  transportType String?
  // Courier partner the customer chose for this line (catalog id, e.g. "blue-dart"),
  // snapshotted from the cart so fulfilment/admin dispatches with the carrier the
  // customer selected. See utils/couriers.js for the label.
  courier String?

  // Full logistics snapshot for this line, frozen at order time so the admin sees
  // exactly what the customer selected/was quoted (couldn't change if the product's
  // config changes later). Shape:
  //   { transportType, courier, totalWeightKg, shippingCostInr, deliveryDays,
  //     dimensions: { length, width, height, unit }, cbmPerUnit, cbmTotal }
  logistics Json?

  // ── Offer snapshot (customer-side only) ─────────────────────────────────────
  // When an automatic Offer reduced this line's selling price, these freeze what the
  // pre-offer price was and which offer applied, so the invoice/order history can show
  // "was ₹X, offer −₹Y". All nullable — lines with no offer (and every legacy line)
  // leave them unset. The vendor payout fields above are untouched: an offer is
  // absorbed by M2C's margin, never passed to the vendor.
  originalUnitPrice Float? // unitPrice before the offer, in the order currency
  appliedOffer      Json? // { offerId, title, type, savingPerUnit } snapshot

  // ── Vendor payout snapshot (always INR) ─────────────────────────────────────
  // What M2C owes the VENDOR for this line, frozen at order time. Distinct from the
  // fields above, which are what the CUSTOMER paid at M2C's marked-up selling price.
  //
  // Frozen, not recomputed on read: the vendor is paid basePrice x qty, but basePrice
  // can change afterwards, and a settlement statement must keep summing to the amount
  // that was actually settled. `attachVendorPrices` derives the same figure live for
  // list views; these columns are the authoritative record a payout advice is built
  // from. All nullable — legacy items predate them, and readers show "—" rather than
  // inventing a number.
  vendorUnitPrice Float? // Vendor's own unit price (Product.basePrice / Variant.price)
  vendorLineBase  Float? // vendorUnitPrice x quantity, before the vendor's GST
  vendorLineTax   Float? // GST on vendorLineBase; 0 for unregistered vendors
  vendorGstRate   Float? // Rate applied to this line (HSN-driven), for the statement

  // Vendor Information
  vendorId   String @db.ObjectId
  vendorName String

  // Link to VendorShipment (set at order creation time)
  shipmentId String?         @db.ObjectId
  shipment   VendorShipment? @relation(fields: [shipmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

model OrderStatusHistory {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status        OrderStatus
  comment       String?
  updatedBy     String? // Admin/Vendor ID who updated
  updatedByType String? // "admin", "vendor", "system"

  timestamp DateTime @default(now())

  @@map("order_status_history")
}

model AdminReview {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Primary link: one review per VendorShipment.
  // Not @unique because existing pre-migration rows have null shipmentId
  // (MongoDB unique indexes reject multiple nulls). Uniqueness enforced in app code.
  shipmentId String?         @db.ObjectId
  shipment   VendorShipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Denormalized order reference (for listing queries).
  // No longer @unique — a multi-vendor order can have multiple reviews.
  orderId String? @db.ObjectId
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Denormalized vendor reference for aggregate rating queries.
  vendorId String? @db.ObjectId
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // Review Details
  reviewComments    String?
  qualityCheckNotes String?
  rating            Int? // 1-5 rating
  approved          Boolean @default(false)

  // Admin Information
  reviewedBy String?   @db.ObjectId // Admin ID
  reviewedAt DateTime?

  // Rejection Details (if applicable)
  rejectionReason String?
  returnToVendor  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([orderId])
  @@index([shipmentId])
  @@map("admin_reviews")
}

// ============================================
// VENDOR SHIPMENT (per-vendor fulfillment unit)
// ============================================

model VendorShipment {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId String @unique // Human-readable e.g. ORD-2024-123456789-V1
  orderId    String @db.ObjectId
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId   String @db.ObjectId
  vendorName String

  // Independent status lifecycle per vendor
  status OrderStatus @default(ORDER_CREATED)

  // Vendor acceptance gate — the vendor must accept the order before an admin can
  // assign a hub and proceed. `acceptanceDeadline` = createdAt + 6h; if it lapses
  // while still unaccepted the overdue sweep notifies admin + vendor once
  // (`acceptanceOverdueNotifiedAt` dedupes it). `acceptanceMins` is how long the
  // vendor took to accept, in minutes — the source for the vendor's rolling average.
  acceptedAt                  DateTime?
  acceptanceDeadline          DateTime?
  acceptanceMins              Float?
  acceptanceOverdueNotifiedAt DateTime?

  // Per-shipment shipping details
  vendorCarrier    String?
  vendorTrackingId String?
  vendorShippedAt  DateTime?

  // Per-shipment hub assignment
  assignedHubId String? @db.ObjectId
  hub           Hub?    @relation(fields: [assignedHubId], references: [id])

  // Items belonging to this shipment
  items OrderItem[]

  // Per-shipment admin review (logically 1:1, enforced in app code)
  adminReviews AdminReview[]

  // Status history
  statusHistory ShipmentStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_shipments")
}

model ShipmentStatusHistory {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId String         @db.ObjectId
  shipment   VendorShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status        OrderStatus
  comment       String?
  updatedBy     String? // Admin/Vendor ID who updated
  updatedByType String? // "admin", "vendor", "system"

  timestamp DateTime @default(now())

  @@map("shipment_status_history")
}

// ============================================
// COUPON MANAGEMENT
// ============================================

model Coupon {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Float
  minPurchaseAmount Float?       @default(0)
  maxDiscountAmount Float? // Max discount cap for percentage based coupons

  startDate  DateTime @default(now())
  expiryDate DateTime

  usageLimit Int? // Total times this coupon can be used globally
  usedCount  Int  @default(0)

  perUserLimit Int? @default(1) // How many times a single user can use this

  // Customer targeting. Empty = available to everyone (the normal case). When
  // non-empty, the coupon is redeemable ONLY by these customer ids — used by the
  // "create for selected customers" flow in Customer Management.
  targetCustomerIds String[] @default([]) @db.ObjectId

  isActive Boolean @default(true)

  // Region availability — which storefront the coupon is redeemable on. IN_ONLY =>
  // .in (INR) only, COM_ONLY => .com (USD) only, BOTH => everywhere. Mirrors the
  // product/offer region model. Monetary fields are stored in INR and converted to
  // the order currency at redemption, so a BOTH/COM coupon works on .com too.
  region PriceVisibility @default(BOTH)

  // "First Order" coupon — only applies to a customer's very first order, and once
  // enabled+active it's the only first-order coupon allowed (surfaced in the
  // storefront's promo strip). At most one active first-order coupon at a time.
  isFirstOrder Boolean @default(false)

  // Dynamic Free Shipping on Nth Orders
  freeShipping             Boolean @default(false) // Whether this coupon grants free shipping
  freeShippingOrderNumbers Int[] // Which order numbers get free shipping (e.g., [3, 5, 10] = 3rd, 5th, 10th orders)

  // Promotional Popup Fields
  showAsPopup          Boolean  @default(false)
  popupImage           String? // Cloudinary URL
  popupTitle           String?
  popupMessage         String?
  applicableCategories String[] // Category names to target (e.g., ["Towel", "Apron"])
  applicableProducts   String[] // Product ids within the chosen categories to target (empty = all products in those categories)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Maker-checker approval — a coupon is held (not usable) until approved.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById   String?   @db.ObjectId
  submittedByName String?
  approvedById    String?   @db.ObjectId
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  @@map("coupons")
}

// ============================================
// OFFERS (automatic, code-less promotions)
// ============================================
//
// Distinct from Coupon: an Offer needs no code. It is an admin-scheduled, time-boxed
// price reduction on the SELLING price (adminFixedPrice/priceINR) of a product, a
// whole category, or the entire store. It surfaces as a badge on the storefront and is
// applied automatically at checkout.
//
// Cost is always absorbed by M2C's margin, never the vendor: the order path discounts
// only the customer's unitPrice, while the vendor settlement keeps using basePrice.
// So an Offer changes nothing in the settlement / vendor-payout modules.
model Offer {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  bannerImage String? // Cloudinary URL, optional (offers page / campaign strip)

  type  OfferType // how the discount is computed
  scope OfferScope // what it targets

  // Discount magnitude. Which field is read depends on `type`:
  //   PERCENTAGE / QUANTITY / THRESHOLD → discountPercent (0-100)
  //   FLAT                               → discountFlatINR (INR source of truth)
  discountPercent Float? // 0-100
  discountFlatINR Float? // per-unit rupees off; USD derived from the FX rate at read

  // Percentage cap, mirrors Coupon.maxDiscountAmount — a % offer can't exceed this
  // many rupees off per unit. Null = uncapped.
  maxDiscountINR Float?

  // Quantity / BOGO parameters (unused by PERCENTAGE/FLAT/THRESHOLD)
  minQty Int? // QUANTITY: buy at least this many of the line to trigger; BOGO: buy N
  getQty Int? // BOGO: number of cheapest units given free per `minQty` bought

  // Cart-threshold parameter (THRESHOLD only): subtotal (INR) must reach this
  minCartValueINR Float?

  // Targeting, read according to `scope`:
  //   PRODUCT  → productIds     (Product.id list)
  //   CATEGORY → categoryNames  (Product.category string list)
  //   STORE    → applies to everything, both lists ignored
  // For a CROSS BOGO this is the BUY set (what the customer must purchase).
  productIds    String[] @default([])
  categoryNames String[] @default([])

  // BOGO free-item mode (BOGO only):
  //   "SAME"  (default/legacy) → buy N and get M of the SAME product free.
  //   "CROSS" → buy N of the buy set above, get M free from the free set below.
  bogoMode String? @default("SAME")

  // CROSS BOGO free (get) set. Read according to `freeScope`; ignored when SAME.
  freeScope         OfferScope?
  freeProductIds    String[]    @default([])
  freeCategoryNames String[]    @default([])

  // Which storefront the offer runs on. Reuses the product visibility enum so an
  // IN_ONLY offer never applies to a .com (USD) order and vice-versa.
  // Customer targeting. Empty = applies for everyone (normal, code-less offer).
  // Non-empty = only these customers get it (created from Customer Management).
  targetCustomerIds String[] @default([]) @db.ObjectId

  region PriceVisibility @default(BOTH)

  // Higher wins when several offers match the same product. Ties broken by deepest
  // scope (PRODUCT > CATEGORY > STORE) then largest saving — resolved in code.
  priority Int @default(0)

  startsAt DateTime @default(now())
  endsAt   DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Maker-checker approval — an offer is held (not applied) until approved.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById   String?   @db.ObjectId
  submittedByName String?
  approvedById    String?   @db.ObjectId
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  @@map("offers")
}

enum OfferType {
  PERCENTAGE // % off the selling price
  FLAT // fixed rupees off per unit
  QUANTITY // buy `minQty`+ of a line → discountPercent off that line
  BOGO // buy `minQty`, get `getQty` cheapest units free
  THRESHOLD // cart subtotal ≥ minCartValueINR → discountPercent off matching lines
}

enum OfferScope {
  PRODUCT
  CATEGORY
  STORE
}

// ============================================
// COURIER PARTNERS (admin-managed, dynamic)
// ============================================
//
// Replaces the previously hard-coded courier catalogue. Admin curates the list; each
// product then selects which of these couriers it ships with (Product.logisticsConfig
// .courierIds). The storefront shows a product's selected couriers, filtered by the
// shopper's region and the chosen transport mode.
model Courier {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String // short badge text, e.g. "BD", "DHL"
  color     String   @default("#1a1a1a") // badge background colour (fallback when no logo)
  logo      String? // optional uploaded logo image URL — shown instead of the code/colour badge
  region    String // 'IN' (domestic) | 'US' (international)
  modes     String[] @default([]) // which transport lanes: 'AIR' and/or 'SHIP'
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // Public tracking-website URL for this courier. May contain a `{tracking}`
  // placeholder that's replaced with the order's tracking ID; otherwise it links
  // to the courier's tracking page (customer pastes the ID there).
  trackingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("couriers")
}

// ============================================
// FREE SHIPPING OFFERS
// ============================================

model FreeShippingOffer {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  minOrderValue Float   @default(0)
  orderNumbers  Int[]   @default([]) // Which order numbers get free shipping (e.g., [3, 5, 10] = 3rd, 5th, 10th orders)
  isActive      Boolean @default(true)

  // Which storefront the offer applies to. IN_ONLY → .in (INR) only, COM_ONLY →
  // .com (USD) only, BOTH → everywhere. Mirrors the product/offer region model.
  region PriceVisibility @default(BOTH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("free_shipping_offers")
}


# ── Database ─────────────────────────────────────────────────────────────
# MongoDB connection string (Prisma datasource).
# Tip for Vercel/serverless: cap the pool so parallel cold starts don't
# exhaust Atlas connections, e.g. append ?maxPoolSize=5
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/m2c?retryWrites=true&w=majority"

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Long random string — signs all JWTs and the express-session secret
JWT_SECRET=change-me-to-a-long-random-string

# ── Bootstrap admin (auto-created on first startup) ──────────────────────
# ADMIN_EMAIL also routes Google OAuth logins to the Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── URLs (OAuth redirects, email links, CORS) ────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── DigitalOcean Spaces (all media storage) ──────────────────────────────
# S3-compatible object storage. Create a Space + an access key pair in the DO
# console. REGION is the Space's region slug (e.g. blr1, nyc3, sgp1). ENDPOINT
# is https://<region>.digitaloceanspaces.com. CDN is the public read base — turn
# on the Space's CDN and use https://<bucket>.<region>.cdn.digitaloceanspaces.com
# (falls back to the origin URL if left blank).
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_SPACES_CDN=

# ── Cloudinary (LEGACY — reads only; no migration) ───────────────────────
# New uploads go to Spaces. Kept so any media still hosted on Cloudinary keeps
# loading and the secure document-proxy can reach legacy files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP (verification, password reset, vendor lifecycle emails) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# ── Razorpay (also configurable per-DB via PaymentSettings) ──────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase push notifications (optional) ───────────────────────────────
# JSON string of the service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Vercel Cron (protects GET /api/jobs/overdue-settlements) ─────────────
# Set the same value in the Vercel project env; Vercel sends it as a Bearer token
CRON_SECRET=
